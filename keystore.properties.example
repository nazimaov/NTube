# Скопировать в keystore.properties (он в .gitignore) и заполнить. SPEC 10.3.
# Ключ создаётся один раз:
#   keytool -genkeypair -v -keystore lumen-release.jks -alias lumen -keyalg RSA -keysize 4096 -validity 10000
# Потеря ключа = невозможность обновлять установленное приложение. Сделайте резервную копию.
storeFile=../lumen-release.jks
storePassword=
keyAlias=lumen
keyPassword=